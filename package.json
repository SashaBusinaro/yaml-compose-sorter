{
  "name": "yaml-compose-sorter",
  "displayName": "Docker Compose Sorter",
  "description": "Standardize and sort Docker Compose files in a consistent way",
  "version": "1.1.1",
  "engines": {
    "vscode": "^1.101.0"
  },
  "license": "MIT",
  "publisher": "SashaBusinaro",
  "homepage": "https://github.com/SashaBusinaro/yaml-compose-sorter/blob/main/README.md",
  "bugs": {
    "url": "https://github.com/SashaBusinaro/yaml-compose-sorter/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SashaBusinaro/yaml-compose-sorter.git"
  },
  "keywords": [
    "docker",
    "dockercompose",
    "docker-compose",
    "compose",
    "yaml",
    "yml",
    "sorting",
    "formatting",
    "organizer",
    "devops",
    "containers"
  ],
  "categories": [
    "Formatters",
    "Other"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#2B5797",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:dockercompose",
    "onLanguage:jinja",
    "onLanguage:jinja-yaml"
  ],
  "main": "./out/extension.js",
  "pricing": "Free",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "yaml-compose-sorter.sort",
        "title": "Sort Docker Compose YAML"
      }
    ],
    "configuration": {
      "title": "Docker Compose Sorter",
      "properties": {
        "yaml-compose-sorter.topLevelKeyOrder": {
          "type": "array",
          "default": [
            "version",
            "name",
            "services",
            "volumes",
            "networks",
            "configs",
            "secrets"
          ],
          "description": "Order of top-level keys in Docker Compose files"
        },
        "yaml-compose-sorter.serviceKeyOrder": {
          "type": "array",
          "default": [
            "container_name",
            "image",
            "build",
            "restart",
            "depends_on",
            "ports",
            "expose",
            "volumes",
            "environment",
            "env_file",
            "networks",
            "labels",
            "healthcheck"
          ],
          "description": "Order of keys within each service definition"
        },
        "yaml-compose-sorter.serviceKeyGroups": {
          "type": "array",
          "default": [
            [
              "container_name"
            ],
            [
              "image",
              "build"
            ],
            [
              "restart",
              "depends_on"
            ],
            [
              "ports",
              "expose"
            ],
            [
              "volumes"
            ],
            [
              "environment",
              "env_file"
            ],
            [
              "networks"
            ],
            [
              "labels",
              "healthcheck"
            ]
          ],
          "description": "Ordered groups of service keys. Used when useServiceKeyGroups is enabled, with blank lines between populated groups.",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "yaml-compose-sorter.useServiceKeyGroups": {
          "type": "boolean",
          "default": false,
          "description": "Use service key groups instead of serviceKeyOrder when groups are configured"
        },
        "yaml-compose-sorter.preserveBlankLinesWithinServiceKeyGroups": {
          "type": "boolean",
          "default": true,
          "description": "Preserve blank lines within configured service-key groups and between unknown service keys"
        },
        "yaml-compose-sorter.addDocumentSeparator": {
          "type": "boolean",
          "default": false,
          "description": "Automatically add '---' document separator at the beginning of YAML files"
        },
        "yaml-compose-sorter.addBlankLinesBetweenTopLevelKeys": {
          "type": "boolean",
          "default": true,
          "description": "Add blank lines between top-level keys for better readability"
        },
        "yaml-compose-sorter.removeVersionKey": {
          "type": "boolean",
          "default": false,
          "description": "Automatically remove the 'version' key from Docker Compose files"
        },
        "yaml-compose-sorter.transformKeyValueLists": {
          "type": "boolean",
          "default": false,
          "description": "Transform arrays of key=value strings into standard YAML key-value maps"
        },
        "yaml-compose-sorter.addBlankLinesBetweenServices": {
          "type": "boolean",
          "default": true,
          "description": "Add blank lines between services in the services section for better readability"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vscode-test",
    "pretest:unit": "npm run compile",
    "test:unit": "mocha --ui tdd out/test/suite/sorter.test.js out/test/suite/adversary.test.js",
    "test:integration": "vscode-test",
    "test:coverage": "vscode-test --coverage --coverage-reporter text --coverage-reporter lcov",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,mjs}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.x",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "mocha": "^12.0.2",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
